# Copy to .env and fill in. .env is gitignored; never commit real credentials.
# Any OpenAI-compatible Chat Completions endpoint works: OpenAI, a LiteLLM proxy,
# vLLM, an Azure-compatible gateway, a local server.
API_BASE=https://your-openai-compatible-endpoint/v1
API_KEY=your-key
MODEL=your-model-name

# --- Web apps (the web domain) ----------------------------------------------
# For the bundled live stack, examples/systems/setup.py writes these for you.
# For your own app, name it in AGENTICHARVEST_WEB_APPS and set its block. The full
# list of settings is in src/agenticharvest/domains/web/config.py.
#
# AGENTICHARVEST_WEB_APPS=hris
# AGENTICHARVEST_WEB_HRIS_URL=https://hr.example.com
# AGENTICHARVEST_WEB_HRIS_SPEC=/openapi.json
# AGENTICHARVEST_WEB_HRIS_SPEC_KIND=openapi
# AGENTICHARVEST_WEB_HRIS_AUTH=bearer
# AGENTICHARVEST_WEB_HRIS_TOKEN=your-token
